<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_0fr9mxs" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.22.0">
  <bpmn:process id="MainDepositCreditProcess" name="MainDepositCreditProcess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="MainDepositCresitStartEvent">
      <bpmn:outgoing>Flow_1fz4ig0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_0x6ir2l">
      <bpmn:incoming>Flow_1b4014z</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="GoingToBankId" name="Going to the bank" camunda:formKey="camunda-forms:/form/way-to-get-to-the-bank.form">
      <bpmn:incoming>Flow_1fz4ig0</bpmn:incoming>
      <bpmn:outgoing>Flow_1mpyck9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1fz4ig0" sourceRef="StartEvent_1" targetRef="GoingToBankId" />
    <bpmn:exclusiveGateway id="Gateway_0s7l7xt" name="Taxi or Walk ?&#10;">
      <bpmn:incoming>Flow_1mpyck9</bpmn:incoming>
      <bpmn:outgoing>Flow_1erhlh3</bpmn:outgoing>
      <bpmn:outgoing>Flow_0de75rc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1mpyck9" sourceRef="GoingToBankId" targetRef="Gateway_0s7l7xt" />
    <bpmn:sequenceFlow id="Flow_1erhlh3" name="Taxi&#10;" sourceRef="Gateway_0s7l7xt" targetRef="PayForTheTaxi">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transportMode=='taxi'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="PayForTheTaxi" name="Pay for the taxi&#10;" camunda:delegateExpression="${taxiPaymentDelegate}">
      <bpmn:incoming>Flow_1erhlh3</bpmn:incoming>
      <bpmn:outgoing>Flow_1jzyusg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0de75rc" name="Walk" sourceRef="Gateway_0s7l7xt" targetRef="GetTicketInQueueMachineId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transportMode=='walk'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1jzyusg" sourceRef="PayForTheTaxi" targetRef="GetTicketInQueueMachineId" />
    <bpmn:userTask id="GetTicketInQueueMachineId" name="GetTicketInQueueMachine&#10;" camunda:formKey="camunda-forms:/form/queue-machine.form">
      <bpmn:incoming>Flow_0de75rc</bpmn:incoming>
      <bpmn:incoming>Flow_1jzyusg</bpmn:incoming>
      <bpmn:outgoing>Flow_14vz21u</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_00m1nap" name="Deposit or Credit">
      <bpmn:incoming>Flow_14vz21u</bpmn:incoming>
      <bpmn:outgoing>Flow_02w7gn2</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ylmruy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_14vz21u" sourceRef="GetTicketInQueueMachineId" targetRef="Gateway_00m1nap" />
    <bpmn:sequenceFlow id="Flow_02w7gn2" name="Ticket deposit " sourceRef="Gateway_00m1nap" targetRef="DepositOpeningProcessId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ticket=='deposit'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1ylmruy" name="Ticket Credit" sourceRef="Gateway_00m1nap" targetRef="GreditObtainingProcessId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${ticket=='credit'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:callActivity id="DepositOpeningProcessId" name="OpenDeposit" calledElement="DepositOpening">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02w7gn2</bpmn:incoming>
      <bpmn:outgoing>Flow_028q52i</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="GreditObtainingProcessId" name="Get a credit" calledElement="CreditObtaining">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ylmruy</bpmn:incoming>
      <bpmn:outgoing>Flow_12ktfyz</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_1wc6ify">
      <bpmn:incoming>Flow_12ktfyz</bpmn:incoming>
      <bpmn:incoming>Flow_028q52i</bpmn:incoming>
      <bpmn:outgoing>Flow_06mfy9m</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_12ktfyz" sourceRef="GreditObtainingProcessId" targetRef="Gateway_1wc6ify" />
    <bpmn:sequenceFlow id="Flow_028q52i" sourceRef="DepositOpeningProcessId" targetRef="Gateway_1wc6ify" />
    <bpmn:callActivity id="ActivityRoadToHomeId" name="RoadToHome" calledElement="GoingHome">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06mfy9m</bpmn:incoming>
      <bpmn:outgoing>Flow_1b4014z</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_06mfy9m" sourceRef="Gateway_1wc6ify" targetRef="ActivityRoadToHomeId" />
    <bpmn:sequenceFlow id="Flow_1b4014z" sourceRef="ActivityRoadToHomeId" targetRef="EndEvent_0x6ir2l" />
    <bpmn:textAnnotation id="TextAnnotation_0ucviml">
      <bpmn:text>Camunda forms   - Choose transport to the bank ( walking or taxi ?)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0qqthut" associationDirection="None" sourceRef="GoingToBankId" targetRef="TextAnnotation_0ucviml" />
    <bpmn:textAnnotation id="TextAnnotation_1l53zf5">
      <bpmn:text>If taxi then reduce money from wallet</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0d2vcl5" associationDirection="None" sourceRef="PayForTheTaxi" targetRef="TextAnnotation_1l53zf5" />
    <bpmn:textAnnotation id="TextAnnotation_0xgr0f6">
      <bpmn:text>Choose ticket in queue machine deposit or credit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_06fhu6z" associationDirection="None" sourceRef="GetTicketInQueueMachineId" targetRef="TextAnnotation_0xgr0f6" />
    <bpmn:textAnnotation id="TextAnnotation_1yeizl1">
      <bpmn:text>Process of deposit opening</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0gumyng" associationDirection="None" sourceRef="DepositOpeningProcessId" targetRef="TextAnnotation_1yeizl1" />
    <bpmn:textAnnotation id="TextAnnotation_0lb7zev">
      <bpmn:text>Process of credit obtaining</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1clzfsp" associationDirection="None" sourceRef="GreditObtainingProcessId" targetRef="TextAnnotation_0lb7zev" />
    <bpmn:textAnnotation id="TextAnnotation_0axxa96">
      <bpmn:text>Choose transport to going home after bank visited</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ubncn5" associationDirection="None" sourceRef="ActivityRoadToHomeId" targetRef="TextAnnotation_0axxa96" />
  </bpmn:process>
