<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1w5n3dg" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.22.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.21.0">
  <bpmn:collaboration id="DepositOpeningCollaboration">
    <bpmn:participant id="DepositOpeningId" name="Deposit opening" processRef="DepositOpening" />
    <bpmn:textAnnotation id="TextAnnotation_11558j7">
      <bpmn:text>1.Check if client has a passport  if not throw an Error, since passport is required!</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0x1kg7x" associationDirection="None" sourceRef="PassportProvodingId" targetRef="TextAnnotation_11558j7" />
    <bpmn:textAnnotation id="TextAnnotation_0a5mj5j">
      <bpmn:text>1.Create and provide list of deposits  2. Set them to ex. variable</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1mo6qnb" associationDirection="None" sourceRef="DepositListProvidingId" targetRef="TextAnnotation_0a5mj5j" />
    <bpmn:textAnnotation id="TextAnnotation_1gd2ljf">
      <bpmn:text>1. Client reads the deposit list  2. Choose the preferred deposit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0r9nf1t" associationDirection="None" sourceRef="DepositChoosingId" targetRef="TextAnnotation_1gd2ljf" />
    <bpmn:textAnnotation id="TextAnnotation_1mtx6lq">
      <bpmn:text>Leave the bank</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_14ymw10" associationDirection="None" sourceRef="Event_1a9v5q3" targetRef="TextAnnotation_1mtx6lq" />
    <bpmn:textAnnotation id="TextAnnotation_14axpzc">
      <bpmn:text>1.Check if during client is already client of our bank  2. Set the checking result to boolean var</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0cqqncq" associationDirection="None" sourceRef="ClientExistingCheckingId" targetRef="TextAnnotation_14axpzc" />
    <bpmn:textAnnotation id="TextAnnotation_0ll2l77">
      <bpmn:text>1. Check if client wanted by police  2. Is client in the banks black list  3.Is client passport valid                4. Set the result to boolean execution variable</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1sh0zxt" associationDirection="None" sourceRef="ClientFullValidationId" targetRef="TextAnnotation_0ll2l77" />
    <bpmn:textAnnotation id="TextAnnotation_1efmmbq">
      <bpmn:text>1.Check if client wanted by police  2. Set the result to boolean execution variable</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0hcol9f" associationDirection="None" sourceRef="ClientParticularValidationId" targetRef="TextAnnotation_1efmmbq" />
    <bpmn:textAnnotation id="TextAnnotation_01ji5nu">
      <bpmn:text>1.Notify client about failure to go home</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1tpj1v9" associationDirection="None" sourceRef="FailedValidationErrorId" targetRef="TextAnnotation_01ji5nu" />
    <bpmn:textAnnotation id="TextAnnotation_0ky19x8">
      <bpmn:text>1. In case client  is criminal - bank worker call to the police station</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ujjr79" associationDirection="None" sourceRef="CallThePoliceId" targetRef="TextAnnotation_0ky19x8" />
    <bpmn:textAnnotation id="TextAnnotation_1ptxun6">
      <bpmn:text>1.Start SMS verification</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_02gughi" associationDirection="None" sourceRef="StartVerificationSmsDelegateId" targetRef="TextAnnotation_1ptxun6" />
  </bpmn:collaboration>
  <bpmn:process id="DepositOpening" name="DepositOpeningName" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1iou4u0">
      <bpmn:lane id="Lane_1qc6l8i" name="Client">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PassportProvodingId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_0bbyn8r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DepositChoosingId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GatewayIsDepositChosenId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_1a9v5q3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ErrorPassportShouldBePresentHandleId</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0s0dfvx" name="BankWorker">
        <bpmn:flowNodeRef>DepositListProvidingId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ClientExistingCheckingId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GatewayIsNewClientId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GatewayMergeIsNewClientId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ClientFullValidationId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ClientParticularValidationId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GatewayIsSuccessValidationId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GatewayIsClientCriminalId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallThePoliceId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FailedValidationErrorId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ClientIsCriminalEroorId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartVerificationSmsDelegateId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndVerificationSmsDelegateId</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1e615x2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_16nt2x1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0dtkh45</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="Flow_1d9o4td" sourceRef="Activity_1e615x2" targetRef="Event_16nt2x1" />
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1wk53p3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PassportProvodingId" name="Provide a passport" camunda:asyncBefore="true" camunda:delegateExpression="${passportProvidingDelegate}">
      <bpmn:incoming>Flow_1wk53p3</bpmn:incoming>
      <bpmn:outgoing>Flow_0m1xxu0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1wk53p3" sourceRef="StartEvent_1" targetRef="PassportProvodingId" />
    <bpmn:sequenceFlow id="Flow_0i89zd5" sourceRef="ErrorPassportShouldBePresentHandleId" targetRef="Event_0bbyn8r" />
    <bpmn:endEvent id="Event_0bbyn8r">
      <bpmn:incoming>Flow_0i89zd5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="ErrorPassportShouldBePresentHandleId" name="Error passport should be present handle" attachedToRef="PassportProvodingId">
      <bpmn:outgoing>Flow_0i89zd5</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1tenj86" errorRef="Error_0fxpg3j" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0m1xxu0" sourceRef="PassportProvodingId" targetRef="DepositListProvidingId" />
    <bpmn:serviceTask id="DepositListProvidingId" name="Provide list of deposits" camunda:delegateExpression="${depositListProvidingDelegate}">
      <bpmn:incoming>Flow_0m1xxu0</bpmn:incoming>
      <bpmn:outgoing>Flow_0nbm4ef</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0nbm4ef" sourceRef="DepositListProvidingId" targetRef="DepositChoosingId" />
    <bpmn:userTask id="DepositChoosingId" name="Take a look in to deposit list and choose one of them" camunda:formKey="camunda-forms:/form/select-bank-deposit.form">
      <bpmn:incoming>Flow_0nbm4ef</bpmn:incoming>
      <bpmn:outgoing>Flow_1pdnywh</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GatewayIsDepositChosenId" name="is deposit selected?">
      <bpmn:incoming>Flow_1pdnywh</bpmn:incoming>
      <bpmn:outgoing>Flow_0klpv6j</bpmn:outgoing>
      <bpmn:outgoing>Flow_0k87ysv</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1pdnywh" sourceRef="DepositChoosingId" targetRef="GatewayIsDepositChosenId" />
    <bpmn:endEvent id="Event_1a9v5q3">
      <bpmn:incoming>Flow_0klpv6j</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0klpv6j" name="no" sourceRef="GatewayIsDepositChosenId" targetRef="Event_1a9v5q3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!execution.hasVariable("depositName") || depositName == null  || depositName == ""}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0k87ysv" name="yes" sourceRef="GatewayIsDepositChosenId" targetRef="ClientExistingCheckingId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable("depositName") &amp;&amp; depositName != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="ClientExistingCheckingId" name="Checking is it new client of existing one" camunda:delegateExpression="${clientExistingCheckingDelegate}">
      <bpmn:incoming>Flow_0k87ysv</bpmn:incoming>
      <bpmn:outgoing>Flow_000fahg</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GatewayIsNewClientId" name="is it existing client?" default="Flow_0mzmslv">
      <bpmn:incoming>Flow_000fahg</bpmn:incoming>
      <bpmn:outgoing>Flow_0mzmslv</bpmn:outgoing>
      <bpmn:outgoing>Flow_0np7e11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_000fahg" sourceRef="ClientExistingCheckingId" targetRef="GatewayIsNewClientId" />
    <bpmn:sequenceFlow id="Flow_0mzmslv" name="no" sourceRef="GatewayIsNewClientId" targetRef="ClientFullValidationId" />
    <bpmn:sequenceFlow id="Flow_0np7e11" name="yes" sourceRef="GatewayIsNewClientId" targetRef="ClientParticularValidationId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isExistingUser}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="GatewayMergeIsNewClientId">
      <bpmn:incoming>Flow_1htewfs</bpmn:incoming>
      <bpmn:incoming>Flow_0xbgkvt</bpmn:incoming>
      <bpmn:outgoing>Flow_1lil6b9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1htewfs" sourceRef="ClientFullValidationId" targetRef="GatewayMergeIsNewClientId" />
    <bpmn:sequenceFlow id="Flow_0xbgkvt" sourceRef="ClientParticularValidationId" targetRef="GatewayMergeIsNewClientId" />
    <bpmn:serviceTask id="ClientFullValidationId" name="Perform full customer validation" camunda:delegateExpression="${clientFullValidationDelegate}">
      <bpmn:incoming>Flow_0mzmslv</bpmn:incoming>
      <bpmn:outgoing>Flow_1htewfs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ClientParticularValidationId" name="Perform particular customer validation" camunda:delegateExpression="${clientParticularValidationDelegate}">
      <bpmn:incoming>Flow_0np7e11</bpmn:incoming>
      <bpmn:outgoing>Flow_0xbgkvt</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GatewayIsSuccessValidationId" name="is client successfully passed validation" default="Flow_0dzid8i">
      <bpmn:incoming>Flow_1lil6b9</bpmn:incoming>
      <bpmn:outgoing>Flow_0dzid8i</bpmn:outgoing>
      <bpmn:outgoing>Flow_1omxxr7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1lil6b9" sourceRef="GatewayMergeIsNewClientId" targetRef="GatewayIsSuccessValidationId" />
    <bpmn:sequenceFlow id="Flow_0dzid8i" sourceRef="GatewayIsSuccessValidationId" targetRef="GatewayIsClientCriminalId" />
    <bpmn:exclusiveGateway id="GatewayIsClientCriminalId" name="Is client criminal?">
      <bpmn:incoming>Flow_0dzid8i</bpmn:incoming>
      <bpmn:outgoing>Flow_11mv562</bpmn:outgoing>
      <bpmn:outgoing>Flow_08iqzso</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_11mv562" name="yes" sourceRef="GatewayIsClientCriminalId" targetRef="CallThePoliceId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isCriminal}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08iqzso" name="no" sourceRef="GatewayIsClientCriminalId" targetRef="FailedValidationErrorId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!isCriminal}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:scriptTask id="CallThePoliceId" name="Call to police" scriptFormat="JavaScript" camunda:resource="script/call-to-police-script.js">
      <bpmn:incoming>Flow_11mv562</bpmn:incoming>
      <bpmn:outgoing>Flow_1d8wlhs</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="FailedValidationErrorId" name="Sudden operation interruption error">
      <bpmn:incoming>Flow_08iqzso</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1eld3j0" errorRef="Error_0fxpg3j" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1d8wlhs" sourceRef="CallThePoliceId" targetRef="ClientIsCriminalEroorId" />
    <bpmn:endEvent id="ClientIsCriminalEroorId" name="Client is criminal error">
      <bpmn:incoming>Flow_1d8wlhs</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_0slp6zq" errorRef="Error_1ymcd9z" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1omxxr7" name="yes" sourceRef="GatewayIsSuccessValidationId" targetRef="StartVerificationSmsDelegateId">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isValidUser}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sendTask id="StartVerificationSmsDelegateId" name="StartVerificationSmsDelegate" camunda:delegateExpression="${startVerificationSmsDelegate}">
      <bpmn:incoming>Flow_1omxxr7</bpmn:incoming>
      <bpmn:outgoing>Flow_0uvmiay</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_0uvmiay" sourceRef="StartVerificationSmsDelegateId" targetRef="EndVerificationSmsDelegateId" />
    <bpmn:receiveTask id="EndVerificationSmsDelegateId" name="EndVerificationSmsDelegate" messageRef="Message_0kkelav">
      <bpmn:incoming>Flow_0uvmiay</bpmn:incoming>
      <bpmn:outgoing>Flow_0vbksx8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:scriptTask id="Activity_1e615x2" name="Deposit opening process" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_0vbksx8</bpmn:incoming>
      <bpmn:outgoing>Flow_1d9o4td</bpmn:outgoing>
      <bpmn:script>print('The client has passed sms verication!');
 </bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="Event_16nt2x1">
      <bpmn:incoming>Flow_1d9o4td</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0vbksx8" sourceRef="EndVerificationSmsDelegateId" targetRef="Activity_1e615x2" />
    <bpmn:subProcess id="Activity_0dtkh45" name="Intermediate throw sub process - from SMS validation to Main process" triggeredByEvent="true">
      <bpmn:startEvent id="StartFailedVerificationSmsMessageId" name="Evenr intermediate sudden operation interruption error start" isInterrupting="false">
        <bpmn:outgoing>Flow_0weft6d</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_0dpurgn" messageRef="Message_22cl6ad" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_0weft6d" sourceRef="StartFailedVerificationSmsMessageId" targetRef="Activity_0c9bagm" />
      <bpmn:scriptTask id="Activity_0c9bagm" name="Intermediate print task">
        <bpmn:incoming>Flow_0weft6d</bpmn:incoming>
        <bpmn:outgoing>Flow_19cqvuq</bpmn:outgoing>
        <bpmn:script>print('the error has thrown from sms verification process to main process');</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="Flow_19cqvuq" sourceRef="Activity_0c9bagm" targetRef="EndFailedVerificationSmsErrorId" />
      <bpmn:endEvent id="EndFailedVerificationSmsErrorId" name="End error from sms verication to main process">
        <bpmn:incoming>Flow_19cqvuq</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEventDefinition_1xrangn" errorRef="Error_0fxpg3j" />
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:error id="Error_0fxpg3j" name="SUDDEN_OPERATION_INTERRUPTION_ERROR" errorCode="SUDDEN_OPERATION_INTERRUPTION_ERROR" />
  <bpmn:error id="Error_1ymcd9z" name="CLIENT_IS_CRIMINAL_ERROR" errorCode="CLIENT_IS_CRIMINAL_ERROR" />
  <bpmn:message id="Message_0kkelav" name="message_successes_sms_verification" />
  <bpmn:message id="Message_22cl6ad" name="message_failed_sms_verification" />
